# ============================================================
# Environment Configuration — Restaurant API
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── General ─────────────────────────────────────────────────
NODE_ENV=Development

# ── Database (PostgreSQL / Neon) ─────────────────────────────
# Format: Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<password>;SSL Mode=require;Channel Binding=require
ConnectionStrings__MyConnectString=Host=<your-db-host>;Port=5432;Database=RestaurantDB;Username=<your-username>;Password=<your-password>;SSL Mode=require;Channel Binding=require

# ── Cloudinary (Image Storage) ───────────────────────────────
# Create a free account at https://cloudinary.com
CLOUDINARY__CLOUDNAME=<your-cloud-name>
CLOUDINARY__APIKEY=<your-api-key>
CLOUDINARY__APISECRET=<your-api-secret>
CLOUDINARY__FOLDER=products

# ── JWT Authentication ───────────────────────────────────────
# Generate a strong random secret (min 64 hex chars recommended):
#   PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
JwtSettings__SecretKey=<your-jwt-secret-key-at-least-32-chars>
JwtSettings__Issuer=RestaurantAPI
JwtSettings__Audience=RestaurantClient

# ── Email (Gmail SMTP) ───────────────────────────────────────
# Use a Gmail App Password (not your account password).
# Guide: https://support.google.com/accounts/answer/185833
EmailSettings__SenderEmail=<your-gmail-address>@gmail.com
EmailSettings__AppPassword=<your-gmail-app-password>
